# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Used to encrypt stored wallet keys — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOT_SECRET_KEY=your_32_byte_fernet_key_here

# Solana RPC (Helius/QuickNode free tier works great)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: URL for Phantom wallet Web App (deploy webapp/index.html)
WEBAPP_URL=https://your-domain.com/webapp

# Optional: OpenAI for smarter AI answers (works without it using built-in AI)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Jupiter API key (free swaps work via lite-api without a key)
JUPITER_API_KEY=

DEFAULT_STOP_LOSS_PCT=15
DEFAULT_TAKE_PROFIT_PCT=50
DEFAULT_MAX_POSITIONS=3
SCAN_INTERVAL_SEC=45
